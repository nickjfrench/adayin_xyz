---
import { priceText, type Currency } from "../utils/cost";

interface Props {
  cost: number;
  currency?: Currency | null;
  class?: string;
}

const { cost, currency = null, class: className = "" } = Astro.props;
---

<span
  class={`inline-flex items-center gap-1 rounded-full bg-sand-100 px-2.5 py-0.5 text-xs font-semibold text-sand-600 ${className}`}
>
  {currency?.icon?.svg && (
    <span class="inline-block h-3 w-3 [&>svg]:h-full [&>svg]:w-full" set:html={currency.icon.svg} />
  )}
  {priceText(cost, currency, { perPerson: false })}
</span>