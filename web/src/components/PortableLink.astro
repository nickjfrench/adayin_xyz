---
// Portable Text link mark override. `node` is the span carrying the link mark,
// so the href lives on its `markDef` — the shape astro-portabletext's own
// `link` renderer uses. Link settles tab target, icon and Umami event.
import type { Mark } from 'astro-portabletext/types'
import Link from './Link.astro'

export type Props = Mark<{ href?: string }>

const { node } = Astro.props
const href = node?.markDef?.href
---

{
  typeof href === 'string' ? (
    <Link href={href}>
      <slot />
    </Link>
  ) : (
    <slot />
  )
}
