---
import Link from './Link.astro'

/**
 * Google Maps link for a stop. Always outbound, so Link adds the new tab and
 * the outbound event; the pin already signals the destination, so the ↗ icon
 * stays off.
 */
interface Props {
  href: string
  text: string
  class?: string
}

const { href, text, class: className = '' } = Astro.props
---

<Link
  href={href}
  showIcon={false}
  class={`inline-flex items-center gap-1 text-xs transition-colors ${className}`}
>
  <svg
    class="h-3 w-3 shrink-0"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
    <circle cx="12" cy="10" r="3"></circle>
  </svg>
  {text}
</Link>
