---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import GlassCard from "../../components/GlassCard.astro";
import { getArticles } from "../../utils/sanity";

const articles = await getArticles();
---

<BaseLayout title="Blog — A Day In" headerVariant="dark">
  <PageHeader
    label="Blog"
    title="Some Itineraries Deserve a Story"
    description="A detailed, behind the scenes look at some of our favourites."
  />

  <section class="mx-auto max-w-6xl px-5 pt-14 pb-20 sm:px-8">
    {
      articles.length === 0 ? (
        <div class="rounded-2xl border border-dashed border-sea-200 bg-sea-50/50 p-10 text-center">
          <p class="font-display text-lg font-semibold text-sea-700">No articles yet</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {articles.map((article) => (
            <GlassCard entry={article} hrefBase="/blog" />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
