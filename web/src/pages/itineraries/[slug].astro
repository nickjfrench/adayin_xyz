---
import { PortableText } from "astro-portabletext";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getItinerary, getItinerarySlugs, urlFor } from "../../utils/sanity";
import { priceText, sumCosts, tripCurrencyFrom, countStops, priceTier } from "../../utils/cost";
import StopCard from "../../components/StopCard.astro";
import ItineraryStopModal from "../../components/ItineraryStopModal.svelte";

export async function getStaticPaths() {
  // Queries used inside getStaticPaths must live here — module-scope consts
  // are not visible in this hoisted context.
  return await getItinerarySlugs();
}

const { slug } = Astro.params;
const post = await getItinerary(slug as string);

if (!post) {
  return Astro.redirect("/itineraries");
}

const dest = post.destination;
const date = post._createdAt
  ? new Date(post._createdAt).toLocaleDateString("en-AU", {
      day: "numeric",
      month: "long",
      year: "numeric",
    })
  : null;

const testedOn = post.testedOn
  ? new Date(post.testedOn).toLocaleDateString("en-AU", { month: "long", year: "numeric" })
  : null;

const stops = post.stops ?? [];
const stopCount = countStops(stops);

const tripTotal = sumCosts(stops);
const tripCurrency = tripCurrencyFrom(stops);
const tier = tripTotal > 0 ? priceTier(tripTotal, tripCurrency) : null;
const showTier = tier != null && Boolean(tripCurrency?.icon?.svg);

// Prepare stop data with resolved image URLs for the modal (urlFor is build-time only)
const modalStops = stops.filter(Boolean).map((s) => ({
  ...s,
  imageUrl: s.image
    ? urlFor(s.image).width(1200).height(514).fit('crop').auto('format').url()
    : undefined,
}));

const hero = post.mainImage
  ? urlFor(post.mainImage).width(1600).height(900).fit("crop").auto("format").url()
  : null;

const modalRecommendations = (post.recommendations ?? []).filter(Boolean).map((item) => ({
  ...item,
  imageUrl: item.image
    ? urlFor(item.image).width(1200).height(514).fit('crop').auto('format').url()
    : undefined,
}));

---

<BaseLayout title={`${post.title} — A Day In`} description={post.excerpt} headerVariant="light">
  <article>
    <!-- Hero -->
    <header id="hero-section" class="relative isolate flex min-h-[50vh] items-end overflow-hidden">
      <div class="absolute inset-0 -z-10">
        {
          hero ? (
            <img src={hero} alt={post.title ?? ""} class="h-full w-full object-cover" />
          ) : (
            <div class="h-full w-full bg-gradient-to-br from-sea-300 to-sea-600" />
          )
        }
        <div class="absolute inset-0 bg-gradient-to-t from-sea-900/80 via-sea-900/30 to-sea-900/10"></div>
      </div>

      <div class="mx-auto w-full max-w-4xl px-5 pb-16 pt-32 sm:px-8">
        {
          dest && (
            <a
              href={`/itineraries?dest=${dest.slug?.current}`}
              class="inline-flex items-center gap-1.5 rounded-full bg-sea-500/95 px-3 py-1 font-display text-xs font-semibold uppercase tracking-wide text-white ring-1 ring-white/20 transition hover:bg-sea-500"
            >
              A day in {dest.city}
              {dest.countryShort && <span class="text-sea-100">· {dest.countryShort}</span>}
            </a>
          )
        }
        {post.audiences && post.audiences.length > 0 && (
          <div data-scroll-chips class="relative mt-3 flex max-w-full items-center gap-2">
            <button type="button" data-sc-prev aria-label="Scroll audience left" class="dest-arrow hidden shrink-0 rounded-full border border-white/30 bg-sea-900/30 p-1 text-white backdrop-blur transition hover:bg-sea-900/50">
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6" /></svg>
            </button>
            <div data-sc-track class="flex gap-2 overflow-x-auto scroll-smooth [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
              {post.audiences.map((a) => (
              <span
                class="inline-flex shrink-0 items-center gap-1 rounded-full border border-sea-300 bg-sea-100/95 px-2.5 py-1 font-display text-xs font-semibold text-sea-700 backdrop-blur-sm"
                title={a.longName ?? a.label}
              >
                {a.icon?.svg && (
                  <span class="inline-block h-3.5 w-3.5 shrink-0 text-sea-600 [&>svg]:h-3.5 [&>svg]:w-3.5" set:html={a.icon.svg} />
                )}
                {a.label}
              </span>
              ))}
            </div>
            <button type="button" data-sc-next aria-label="Scroll audience right" class="dest-arrow hidden shrink-0 rounded-full border border-white/30 bg-sea-900/30 p-1 text-white backdrop-blur transition hover:bg-sea-900/50">
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6" /></svg>
            </button>
          </div>
        )}
        <h1 class="mt-4 font-display text-3xl font-semibold leading-tight text-white drop-shadow-md sm:text-5xl">
          {post.title}
        </h1>
        <div class="mt-3 flex flex-col gap-1 text-sm font-medium text-white/80">
          {post.authorName && (
            <div class="flex flex-wrap items-center gap-x-2">
              <span>Written by {post.authorName}</span>
              {date && <><span class="text-white/50">·</span><span>{date}</span></>}
            </div>
          )}
          {(post.testedBy || testedOn) && (
            <div class="flex flex-wrap items-center gap-x-2 text-white/70">
              {post.testedBy && <span>Tested by {post.testedBy}</span>}
              {post.testedBy && testedOn && <span class="text-white/50">·</span>}
              {testedOn && <span>{testedOn}</span>}
            </div>
          )}
        </div>
      </div>
    </header>

    <!-- Metadata overlay bar -->
    <div class="relative z-10 mx-5 -mt-8 flex max-w-4xl flex-wrap items-center justify-center gap-x-10 gap-y-2 rounded-xl bg-white/90 px-5 py-3 text-sm text-sea-700 shadow-lg shadow-sea-900/10 backdrop-blur-sm sm:mx-auto sm:px-8">
      {post.duration && <span class="whitespace-nowrap text-sea-600">{post.duration}</span>}
      {stopCount > 0 && <span class="whitespace-nowrap text-sea-600">{stopCount} stops</span>}
      {tripTotal > 0 ? (
        <span class="inline-flex items-center whitespace-nowrap font-medium text-sea-700" title="Per person total">
          {showTier && Array.from({length: tier ?? 0}).map(() => (
            <span class="inline-block h-3.5 w-3.5 [&>svg]:h-full [&>svg]:w-full text-sea-600" set:html={tripCurrency?.icon?.svg ?? ''} />
          ))}
          {!showTier && (
            <>
              {tripCurrency?.icon?.svg && (
                <span class="inline-block h-3.5 w-3.5 [&>svg]:h-full [&>svg]:w-full text-sea-600" set:html={tripCurrency.icon.svg} />
              )}
              {priceText(tripTotal, tripCurrency)}
            </>
          )}
        </span>
      ) : (
        <span class="whitespace-nowrap font-medium text-sea-600">Free</span>
      )}
    </div>

    <!-- Body -->
    <div class="mx-auto max-w-4xl flex flex-col gap-10 px-5 pt-8 pb-16 sm:px-8">

      {post.excerpt && <p class="border-l-4 border-sand-300 pl-4 text-lg italic text-sea-700">{post.excerpt}</p>}

      <!-- The itinerary, stop by stop -->
      {
        stops.length > 0 && (
          <section class="border-t border-sea-100 pt-8">
            <h2 class="mb-6 font-display text-2xl font-semibold text-sea-800">Our day, stop by stop</h2>
            <p class="-mt-4 mb-6 italic text-xs text-sand-500">All prices are per person</p>
            <ol class="flex flex-col">
              {stops.filter(Boolean).map((stop, i) => (
                <StopCard stop={stop} index={i} />
              ))}
            </ol>
          </section>
        )
      }

      {
        post.closing && (
          <div class="border-t border-sea-100 pt-8">
            <h2 class="font-display text-2xl font-semibold text-sea-800">Closing notes</h2>
            <div class="prose-sea">
              <PortableText value={post.closing} />
            </div>
          </div>
        )
      }

      {
        post.recommendations && post.recommendations.filter(Boolean).length > 0 && (
          <section class="border-t border-sea-100 pt-8">
            <h2 class="mb-6 font-display text-2xl font-semibold text-sea-800">
              Extend your day
            </h2>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {post.recommendations.filter(Boolean).map((item, i) => (
                <button
                  data-recommendation-index={i}
                  class="group relative aspect-[16/10] cursor-pointer overflow-hidden rounded-xl shadow-sm shadow-sea-900/5 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-md hover:shadow-sea-900/10"
                >
                  {item.stopType?.label && (
                    <span class="absolute top-2 left-2 z-10 inline-flex items-center gap-1.5 rounded-full bg-sea-500/95 px-2 py-0.5 text-xs font-medium text-white shadow-sm [&>svg]:h-3 [&>svg]:w-3">
                      {item.stopType.icon?.svg && <Fragment set:html={item.stopType.icon.svg} />}
                      {item.stopType.label}
                    </span>
                  )}
                  <span class="absolute top-2 right-2 z-10 inline-flex h-6 w-6 items-center justify-center rounded-full bg-white/80 text-sea-600 shadow-sm">
                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 3 21 3 21 9" /><polyline points="9 21 3 21 3 15" /><line x1="21" y1="3" x2="14" y2="10" /><line x1="3" y1="21" x2="10" y2="14" /></svg>
                  </span>
                  {item.image ? (
                    <img
                      src={urlFor(item.image).width(600).height(375).fit("crop").auto("format").url()}
                      alt={item.title ?? ""}
                      loading="lazy"
                      class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                  ) : (
                    <div class="absolute inset-0 bg-gradient-to-br from-sea-100 to-sea-200" />
                  )}
                  <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-sea-900/50 to-transparent p-3 pt-8">
                    <h3 class="font-display text-sm font-semibold leading-snug text-white drop-shadow-sm group-hover:underline">
                      {item.title}
                    </h3>
                    {item.description && (
                      <p class="mt-0.5 line-clamp-1 text-xs text-white/80">{item.description}</p>
                    )}
                  </div>
                </button>
              ))}
            </div>
          </section>
        )
      }

      <div class="flex items-center justify-between border-t border-sea-100 pt-8">
        <a href="/itineraries" class="font-display text-sm font-medium text-sea-600 hover:text-sea-500">← All itineraries</a>
        {
          dest && (
            <a
              href={`/itineraries?dest=${dest.slug?.current}`}
              class="font-display text-sm font-medium text-sea-600 hover:text-sea-500"
            >
              More from {dest.city} →
            </a>
          )
        }
      </div>
    </div>

    {(modalStops.length > 0 || modalRecommendations.length > 0) && (
      <ItineraryStopModal client:load stops={modalStops} recommendations={modalRecommendations} />
    )}
  </article>

<script>
  import { initAllScrollChips } from "../../utils/scrollChips";
  initAllScrollChips();
</script>
</BaseLayout>
