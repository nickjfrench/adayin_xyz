---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import DestBar from "../../components/DestBar.astro";
import GlassCard from "../../components/GlassCard.astro";
import { getDestinations, getItineraries } from "../../utils/sanity";
import { sumCosts, tripCurrencyFrom } from "../../utils/cost"

const destinations = await getDestinations();
const posts = await getItineraries();
---

<BaseLayout title="The Journal — A Day In">
  <PageHeader
    label="Our Itineraries"
    title="From Our Most Recent Adventures"
  />

  <DestBar destinations={destinations} class="-mt-10" />

  <section id="stories" class="mx-auto max-w-6xl scroll-mt-24 px-5 pt-10 pb-16 sm:px-8">
    {
      posts.length === 0 ? (
        <div class="rounded-2xl border border-dashed border-sea-200 bg-sea-50/50 p-10 text-center">
          <p class="font-display text-lg font-semibold text-sea-700">No itineraries yet</p>
        </div>
      ) : (
        <>
          <div id="stories-grid" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {posts.map((post) => (
              <GlassCard entry={post} totalCost={sumCosts(post.stopCosts)} tripCurrency={tripCurrencyFrom(post.stopCosts)} />
            ))}
          </div>
          <p
            id="stories-empty"
            hidden
            class="rounded-2xl border border-dashed border-sea-200 bg-sea-50/50 p-10 text-center text-sm text-deep/60"
          >
            No itineraries from here yet — check back soon.
          </p>
        </>
      )
    }
  </section>
</BaseLayout>

<script>
  import { initDestBar } from "../../utils/destBarClient";
  initDestBar();
</script>
