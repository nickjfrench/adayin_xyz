PUBLIC_SANITY_PROJECT_ID=9egf9s0z
PUBLIC_SANITY_DATASET=development

# Itinerary route map feature flag (default: shown).
# Set to false | 0 | off to hide the map section, its JS chunk, and the
# "Show on Map" buttons from the web build.
# PUBLIC_SHOW_ITINERARY_MAP=false

# Umami analytics. `devenv up` runs a local Umami on http://localhost:3000,
# seeds it with the website id below (admin / umami), and prints the dashboard
# URL. Production builds (Cloudflare Pages) point both values at Umami Cloud:
# PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
PUBLIC_UMAMI_SCRIPT_URL=http://localhost:3000/script.js
PUBLIC_UMAMI_WEBSITE_ID=20aa1b93-f0cd-4507-8cba-159e6a6d01a4
