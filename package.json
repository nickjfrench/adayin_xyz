{
  "name": "adayin-xyz",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev:web": "pnpm --filter adayin-xyz-web dev",
    "dev:studio": "pnpm --filter adayin-xyz-studio dev",
    "build:web": "pnpm --filter adayin-xyz-web build",
    "build:studio": "pnpm --filter adayin-xyz-studio build",
    "deploy:studio": "pnpm --filter adayin-xyz-studio deploy",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r --no-bail exec tsc --noEmit"
  }
}
